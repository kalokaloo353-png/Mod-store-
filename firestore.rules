rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jacobfhernandez14@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // License keys generated by Admin
    match /licenseKeys/{keyId} {
      allow read, write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && incoming().userId == userId
        && incoming().email is string
        && incoming().displayName is string
        && incoming().displayName.size() <= 80;
      allow update: if (isOwner(userId) && incoming().email == existing().email) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // User saved mods
      match /savedMods/{modId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User installed mods
      match /installedMods/{modId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Mods repository - 100% genuine user and admin submissions
    match /mods/{modId} {
      allow read: if true;
      allow create: if isSignedIn()
        && (incoming().authorId == request.auth.uid || isAdmin())
        && incoming().title is string
        && incoming().title.size() <= 100
        && incoming().summary is string
        && incoming().summary.size() <= 200
        && (!('paymentUrl' in incoming()) || (incoming().paymentUrl is string && incoming().paymentUrl.size() <= 2000));
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().authorId == request.auth.uid && incoming().authorId == request.auth.uid) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['downloadCount', 'likesCount'])
      );
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());

      // Mod reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn()
          && incoming().userId == request.auth.uid
          && incoming().rating is number
          && incoming().rating >= 1 && incoming().rating <= 5
          && incoming().comment is string
          && incoming().comment.size() <= 1000;
        allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      }
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
